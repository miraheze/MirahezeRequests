{
	"name": "MirahezeRequests",
	"author": [
		"Pskyechology",
		"Reception123",
		"Waki285"
	],
	"url": "https://github.com/miraheze/MirahezeRequests",
	"descriptionmsg": "mirahezerequests-desc",
	"namemsg": "mirahezerequests-extensionname",
	"license-name": "GPL-3.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.46.0",
		"platform": {
			"php": ">= 8.4"
		}
	},
	"MessagesDirs": {
		"MirahezeRequests": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"MirahezeRequestsAliases": "MirahezeRequestsAliases.php"
	},
	"AutoloadNamespaces": {
		"Miraheze\\MirahezeRequests\\": "includes/",
		"Miraheze\\MirahezeRequests\\Maintenance\\": "maintenance/"
	},
	"TestAutoloadNamespaces": {
		"Miraheze\\MirahezeRequests\\Tests\\": "tests/phpunit/"
	},
	"GroupPermissions": {
		"*": {
			"request-account": true
		}
	},
	"AvailableRights": [
		"handle-requestaccount",
		"request-account"
	],
	"LogActionsHandlers": {
		"requestaccount/*": "MediaWiki\\Logging\\LogFormatter"
	},
	"LogHeaders": {
		"requestaccount": "requestaccount-log-header"
	},
	"LogNames": {
		"requestaccount": "requestaccount-log-name"
	},
	"LogTypes": [
		"requestaccount"
	],
	"LogRestrictions": {
		"requestaccount": "handle-requestaccount"
	},
	"RateLimits": {
		"requestaccount": {
			"ip-all": [
				3,
				3600
			],
			"subnet-all": [
				10,
				86400
			]
		}
	},
	"SpecialPages": {
		"RequestAccount": {
			"class": "Miraheze\\MirahezeRequests\\Specials\\SpecialRequestAccount",
			"services": [
				"MirahezeRequestsDatabaseService",
				"MirahezeRequestsAccountRequestRouter",
				"ExtensionRegistry",
				"MirahezeRequestsAccountRequestMailer",
				"RequestAccountManager",
				"MirahezeRequestsUsernameValidator"
			]
		},
		"RequestAccountQueue": {
			"class": "Miraheze\\MirahezeRequests\\Specials\\Queue\\SpecialRequestAccountQueue",
			"services": [
				"MirahezeRequestsDatabaseService",
				"UserFactory",
				"MirahezeRequestsAccountRequestRouter",
				"AuthManager",
				"ExtensionRegistry",
				"FormatterFactory",
				"MirahezeRequestsAccountCreator",
				"MirahezeRequestsAccountRequestMailer",
				"RequestAccountManager"
			]
		}
	},
	"ResourceModules": {
		"ext.mirahezerequests.tabs": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxMessage",
				"CdxTabs",
				"CdxTab"
			],
			"dependencies": [
				"vue"
			],
			"packageFiles": [
				"ext.mirahezerequests.tabs/init.js",
				"ext.mirahezerequests.tabs/App.vue"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "MirahezeRequests/resources"
	},
	"config": {
		"MirahezeRequestsAccountConfirmationExpiry": {
			"value": 86400,
			"description": "Seconds a requester has to confirm their email address. Unconfirmed requests are deleted afterwards."
		},
		"MirahezeRequestsAccountRequestsOpen": {
			"value": true,
			"description": "Whether Special:RequestAccount accepts new requests. Requests submitted before can still be confirmed and handled."
		},
		"MirahezeRequestsIPVisibilityGroups": {
			"value": [],
			"description": "Array of user group names allowed to see requesters' IP addresses on requests that capture one (e.g. account requests). If empty (the default), nobody can see IPs, regardless of the handle-* right - this must be explicitly configured. If non-empty, only handlers who are also in one of these groups can see IPs."
		},
		"MirahezeRequestsIPRetentionDays": {
			"value": 90,
			"description": "Days to keep a request's IP address, counted from when the request was handled, or from submission while it is still open. Purging runs when requests are submitted, when handlers view the queue, and through the PurgeExpiredAccountRequests maintenance script. Set to 0 to keep IP addresses."
		}
	},
	"ConfigRegistry": {
		"MirahezeRequests": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"Hooks": {
		"ConfirmEditCanUserSkipCaptcha": {
			"handler": "ConfirmEdit"
		},
		"ConfirmEditTriggersCaptcha": {
			"handler": "ConfirmEdit"
		},
		"ExemptFromAccountCreationThrottle": {
			"handler": "Main"
		},
		"GetAllBlockActions": {
			"handler": "Main"
		},
		"LoadExtensionSchemaUpdates": {
			"handler": "Installer"
		},
		"UserGetReservedNames": {
			"handler": "Main"
		}
	},
	"HookHandlers": {
		"ConfirmEdit": {
			"class": "Miraheze\\MirahezeRequests\\Hooks\\Handlers\\ConfirmEdit",
			"services": [
				"MainConfig",
				"MirahezeRequestsAccountCreator"
			]
		},
		"Installer": {
			"class": "Miraheze\\MirahezeRequests\\Hooks\\Handlers\\Installer"
		},
		"Main": {
			"class": "Miraheze\\MirahezeRequests\\Hooks\\Handlers\\Main",
			"services": [
				"MirahezeRequestsDatabaseService",
				"MirahezeRequestsAccountCreator"
			]
		}
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"DatabaseVirtualDomains": [
		"virtual-mirahezerequests"
	],
	"manifest_version": 2
}
