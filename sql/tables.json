[
	{
		"name": "account_requests",
		"comment": "",
		"columns": [
			{
				"name": "request_id",
				"comment": "Unique auto-increment ID",
				"type": "bigint",
				"options": {
					"autoincrement": true,
					"notnull": true,
					"unsigned": true
				}
			},
			{
				"name": "request_actor",
				"comment": "Account the request was submitted from; null if logged out, as the actor would keep the IP",
				"type": "bigint",
				"options": {
					"notnull": false,
					"unsigned": true
				}
			},
			{
				"name": "request_timestamp",
				"comment": "",
				"type": "mwtimestamp",
				"options": {
					"notnull": true
				}
			},
			{
				"name": "request_email",
				"comment": "",
				"type": "string",
				"options": {
					"notnull": true,
					"length": 255
				}
			},
			{
				"name": "request_username",
				"comment": "",
				"type": "string",
				"options": {
					"notnull": true,
					"length": 255
				}
			},
			{
				"name": "request_name_warnings",
				"comment": "JSON list of the username checks that failed on submission, as HTML",
				"type": "blob",
				"options": {
					"notnull": false,
					"length": 65530
				}
			},
			{
				"name": "request_reason",
				"comment": "",
				"type": "mwenum",
				"options": {
					"notnull": true,
					"PlatformOptions": {
						"enum_values": [
							"globalblock",
							"abusefilter",
							"captcha",
							"other"
						]
					}
				}
			},
			{
				"name": "request_globalblock_reason",
				"comment": "Reason of the global block, if that was the reason",
				"type": "mwenum",
				"options": {
					"notnull": false,
					"PlatformOptions": {
						"enum_values": [
							"crosswiki-abuse",
							"crosswiki-spam",
							"crosswiki-vandalism",
							"longterm-abuse",
							"proxy",
							"trust-safety",
							"other"
						]
					}
				}
			},
			{
				"name": "request_explanation",
				"comment": "",
				"type": "blob",
				"options": {
					"notnull": true,
					"length": 16777215
				}
			},
			{
				"name": "request_status",
				"comment": "",
				"type": "mwenum",
				"options": {
					"notnull": true,
					"PlatformOptions": {
						"enum_values": [
							"complete",
							"declined",
							"pending",
							"starting",
							"unconfirmed"
						]
					}
				}
			},
			{
				"name": "request_ccemail",
				"comment": "",
				"type": "mwtinyint",
				"options": {
					"notnull": true,
					"unsigned": true,
					"default": 0
				}
			},
			{
				"name": "request_comments",
				"comment": "Optional additional comments from the requester",
				"type": "blob",
				"options": {
					"notnull": true,
					"length": 16777215,
					"default": ""
				}
			},
			{
				"name": "request_ip",
				"comment": "The IP address the request was submitted from",
				"type": "string",
				"options": {
					"notnull": true,
					"length": 45
				}
			},
			{
				"name": "request_language",
				"comment": "Language the requester used, for emails to them",
				"type": "string",
				"options": {
					"notnull": true,
					"length": 35
				}
			},
			{
				"name": "request_token",
				"comment": "Hash of the email confirmation token",
				"type": "string",
				"options": {
					"notnull": false,
					"length": 64
				}
			},
			{
				"name": "request_confirmed_timestamp",
				"comment": "",
				"type": "mwtimestamp",
				"options": {
					"notnull": false
				}
			},
			{
				"name": "request_completed_timestamp",
				"comment": "When the request was resolved (accepted/declined/failed)",
				"type": "mwtimestamp",
				"options": {
					"notnull": false
				}
			},
			{
				"name": "request_completed_actor",
				"comment": "Who resolved the request",
				"type": "bigint",
				"options": {
					"notnull": false,
					"unsigned": true
				}
			},
			{
				"name": "request_notes",
				"comment": "Notes on how the request was resolved",
				"type": "blob",
				"options": {
					"notnull": true,
					"length": 65530,
					"default": ""
				}
			}
		],
		"indexes": [
			{
				"name": "account_request_actor_timestamp",
				"comment": "",
				"columns": [
					"request_actor",
					"request_timestamp"
				],
				"unique": false
			},
			{
				"name": "account_request_timestamp",
				"comment": "",
				"columns": [
					"request_timestamp"
				],
				"unique": false
			},
			{
				"name": "account_request_email",
				"comment": "",
				"columns": [
					"request_email"
				],
				"unique": false
			},
			{
				"name": "account_request_username",
				"comment": "",
				"columns": [
					"request_username"
				],
				"unique": false
			},
			{
				"name": "account_request_status",
				"comment": "",
				"columns": [
					"request_status"
				],
				"unique": false
			},
			{
				"name": "account_request_token",
				"comment": "",
				"columns": [
					"request_token"
				],
				"unique": false
			}
		],
		"pk": [
			"request_id"
		]
	}
]
